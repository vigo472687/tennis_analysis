{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tennis.local/contracts/v1/report-input.schema.json",
  "title": "Tennis report-input v1",
  "definitions": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "accessed_on": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "supports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "source_id",
        "title",
        "author",
        "url",
        "accessed_on",
        "supports",
        "scope",
        "limitations"
      ],
      "additionalProperties": false
    },
    "problem": {
      "type": "object",
      "properties": {
        "problem_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "confidence": {
          "$ref": "common.schema.json#/definitions/confidence"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200,
          "minItems": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "priority_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "problem_id",
        "statement",
        "impact",
        "confidence",
        "evidence_ids",
        "source_ids",
        "limitations",
        "alternative_explanations",
        "priority_reason"
      ],
      "additionalProperties": false
    },
    "drill": {
      "type": "object",
      "properties": {
        "drill_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200,
          "minItems": 1
        },
        "frequency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "dose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "progression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200,
          "minItems": 1
        },
        "retest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "drill_id",
        "goal",
        "steps",
        "frequency",
        "dose",
        "progression",
        "stop_conditions",
        "retest"
      ],
      "additionalProperties": false
    },
    "training": {
      "type": "object",
      "properties": {
        "weeks": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "drills": {
          "type": "array",
          "items": {
            "$ref": "report-input.schema.json#/definitions/drill"
          },
          "maxItems": 8,
          "minItems": 1
        },
        "retest_protocol": {
          "type": "object",
          "properties": {
            "camera": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "repetitions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "ball_task": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "observations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 200
            },
            "success_conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "maxItems": 200
            }
          },
          "required": [
            "camera",
            "repetitions",
            "ball_task",
            "observations",
            "success_conditions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "weeks",
        "drills",
        "retest_protocol"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "complete",
            "partial",
            "reshoot_required",
            "unsupported",
            "safety_stop",
            "failed",
            "cancelled"
          ]
        },
        "primary_route": {
          "type": "string",
          "enum": [
            "question_answer",
            "tactics",
            "technical_diagnosis",
            "style_optimization"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "safety": {
          "type": "string",
          "enum": [
            "clear",
            "pain",
            "injury",
            "dizziness",
            "worsening",
            "rehab",
            "fatigue",
            "uncertain"
          ]
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "report-input.schema.json#/definitions/problem"
          },
          "maxItems": 3
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "report-input.schema.json#/definitions/source"
          },
          "maxItems": 200
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/evidence"
          },
          "maxItems": 200
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/metric"
          },
          "maxItems": 200
        },
        "timing": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/timing_event"
          },
          "maxItems": 200
        },
        "training": {
          "anyOf": [
            {
              "$ref": "report-input.schema.json#/definitions/training"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "target": {
          "anyOf": [
            {
              "$ref": "analysis.schema.json#/definitions/target_result"
            },
            {
              "type": "null"
            }
          ]
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "task_id",
        "version",
        "state",
        "primary_route",
        "summary",
        "safety",
        "problems",
        "sources",
        "evidence",
        "metrics",
        "timing",
        "training",
        "limitations",
        "target",
        "simulation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "safety_stop"
              }
            }
          },
          "then": {
            "properties": {
              "training": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "safety": {
                "enum": [
                  "pain",
                  "injury",
                  "dizziness",
                  "worsening",
                  "rehab",
                  "uncertain"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "training": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "coach_round": {
      "type": "object",
      "properties": {
        "coach_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "reply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "consensus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "suitability": {
          "type": "string",
          "enum": [
            "suitable_for_current_goal",
            "continue_observing",
            "insufficient_evidence"
          ]
        }
      },
      "required": [
        "coach_id",
        "round",
        "goal",
        "question",
        "reply",
        "evidence_ids",
        "conditions",
        "consensus",
        "unresolved",
        "suitability"
      ],
      "additionalProperties": false
    }
  }
}
