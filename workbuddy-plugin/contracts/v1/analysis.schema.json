{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tennis.local/contracts/v1/analysis.schema.json",
  "title": "Tennis analysis v1",
  "definitions": {
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "video_frame",
            "video_clip",
            "trajectory",
            "user_statement",
            "quality_frame"
          ]
        },
        "asset_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "subject_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "original_start_s": {
          "type": "number",
          "minimum": 0
        },
        "original_end_s": {
          "type": "number",
          "minimum": 0
        },
        "visible_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "body",
              "feet",
              "ball",
              "racket"
            ]
          },
          "maxItems": 200
        },
        "resource": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "common.schema.json#/definitions/resource"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "evidence_frame",
                        "evidence_clip",
                        "trajectory"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "asset_id",
        "subject_id",
        "original_start_s",
        "original_end_s",
        "visible_objects",
        "resource",
        "simulation"
      ],
      "additionalProperties": false
    },
    "stroke": {
      "type": "object",
      "properties": {
        "event_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "forehand",
            "single_backhand",
            "double_backhand",
            "serve",
            "forehand_volley",
            "backhand_volley",
            "footwork",
            "unable"
          ]
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "confidence": {
          "$ref": "common.schema.json#/definitions/confidence"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        }
      },
      "required": [
        "event_id",
        "kind",
        "start_s",
        "end_s",
        "phases",
        "confidence",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "strokes_result": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/stroke"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "events",
        "simulation"
      ],
      "additionalProperties": false
    },
    "timing_event": {
      "type": "object",
      "properties": {
        "event_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "preparation",
            "first_step",
            "main_movement",
            "moving_backswing",
            "bounce_candidate",
            "adjustment",
            "support",
            "racket_drop",
            "leg_drive_rotation",
            "forward_swing",
            "recovery"
          ]
        },
        "original_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "value_state": {
          "$ref": "common.schema.json#/definitions/state_of_value"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "body",
              "feet",
              "ball",
              "racket"
            ]
          },
          "maxItems": 200
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        }
      },
      "required": [
        "event_id",
        "kind",
        "original_s",
        "value_state",
        "requires",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "timing_result": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/timing_event"
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "events",
        "limitations",
        "simulation"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "metric_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "value": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "value_state": {
          "$ref": "common.schema.json#/definitions/state_of_value"
        },
        "unit": {
          "type": "string",
          "enum": [
            "relative",
            "normalized",
            "ratio",
            "event_order"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        }
      },
      "required": [
        "metric_id",
        "definition",
        "value",
        "value_state",
        "unit",
        "reference",
        "evidence_ids",
        "limitations"
      ],
      "additionalProperties": false
    },
    "metrics_result": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/metric"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "metrics",
        "simulation"
      ],
      "additionalProperties": false
    },
    "evidence_input": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "frame_start": {
          "type": "integer",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0,
          "description": "Must be greater than or equal to frame_start."
        },
        "include_zoom": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "task_id",
        "version"
      ],
      "oneOf": [
        {
          "required": [
            "candidate_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "frame_start"
                ]
              },
              {
                "required": [
                  "frame_end"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "frame_start",
            "frame_end"
          ],
          "not": {
            "required": [
              "candidate_id"
            ]
          }
        }
      ],
      "additionalProperties": false,
      "description": "Retrieve by exactly one mode: candidate_id, or an inclusive frame_start/frame_end range. Window levels (20/40/80) and frame limits (200/600) are backend constants and are intentionally not request fields."
    },
    "hit_candidate": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "interval_start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "interval_end_frame": {
          "type": "integer",
          "minimum": 0
        },
        "original_s": {
          "type": "object",
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "description": "Inclusive candidate interval mapped to the original-video timeline; end must not precede start."
        },
        "basis": {
          "type": "string",
          "enum": [
            "ball_racket",
            "ball_track",
            "pose_only"
          ]
        },
        "basis_error_frames": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "window_level": {
          "type": "integer",
          "enum": [
            20,
            40,
            80
          ]
        }
      },
      "required": [
        "candidate_id",
        "interval_start_frame",
        "interval_end_frame",
        "original_s",
        "basis",
        "basis_error_frames",
        "confidence",
        "window_level"
      ],
      "additionalProperties": false,
      "description": "A review candidate, never a frame-precise hit conclusion."
    },
    "ball_trajectory": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "original_s": {
          "type": "number",
          "minimum": 0
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "detected",
            "recovered",
            "lowthr",
            "estimated"
          ]
        },
        "peak": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "frame",
        "original_s",
        "x",
        "y",
        "source",
        "peak"
      ],
      "additionalProperties": false,
      "description": "One normalized trajectory point. estimated points and gaps are visually distinct from detections and never enter metrics."
    },
    "evidence_result": {
      "type": "object",
      "properties": {
        "frames": {
          "type": "array",
          "maxItems": 600,
          "items": {
            "type": "object",
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0
              },
              "time_s": {
                "type": "number",
                "minimum": 0
              },
              "image": {
                "allOf": [
                  {
                    "$ref": "common.schema.json#/definitions/resource"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "evidence_frame"
                      }
                    }
                  }
                ]
              },
              "zoom": {
                "anyOf": [
                  {
                    "allOf": [
                      {
                        "$ref": "common.schema.json#/definitions/resource"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "evidence_zoom"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ball_box": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ball_confidence": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "racket_box": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "racket_confidence": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pose_valid": {
                "type": "boolean"
              },
              "markers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "ball_racket_anchor",
                    "ball_track_event",
                    "wrist_peak"
                  ]
                },
                "maxItems": 3,
                "uniqueItems": true
              },
              "candidate_id": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/definitions/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "frames_to_anchor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "frame",
              "time_s",
              "image",
              "zoom",
              "ball_box",
              "ball_confidence",
              "racket_box",
              "racket_confidence",
              "pose_valid",
              "markers",
              "candidate_id",
              "frames_to_anchor"
            ],
            "additionalProperties": false
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/hit_candidate"
          },
          "maxItems": 200
        },
        "trajectory": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/ball_trajectory"
          },
          "maxItems": 600
        },
        "window_level": {
          "anyOf": [
            {
              "type": "integer",
              "enum": [
                20,
                40,
                80
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "not_retained",
                "expired",
                "no_candidate"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2048
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "frames",
        "window_level",
        "truncated",
        "reason",
        "message",
        "simulation"
      ],
      "additionalProperties": false,
      "description": "Detection evidence only. It carries no field asserting that a hit occurred. Zoom resources use the dedicated evidence_zoom kind."
    },
    "storage_input": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "retain_mode": {
          "type": "string",
          "enum": [
            "route_trimmed",
            "full"
          ]
        }
      },
      "required": [
        "task_id",
        "version",
        "retain_mode"
      ],
      "additionalProperties": false
    },
    "storage_estimate": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "route_trimmed",
            "full"
          ]
        },
        "retained_frames": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "retained_frames",
        "estimated_bytes",
        "ranges",
        "requires_confirmation",
        "simulation"
      ],
      "additionalProperties": false,
      "description": "An estimate for user choice, not a storage guarantee. full requires explicit user confirmation before analysis.create is called with retain_mode=full."
    },
    "render_input": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200,
          "minItems": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "frame",
            "trajectory",
            "slow_motion"
          ]
        }
      },
      "required": [
        "operation_id",
        "task_id",
        "version",
        "evidence_ids",
        "mode"
      ],
      "additionalProperties": false
    },
    "render_result": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/resource"
          },
          "maxItems": 200
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/evidence"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "resources",
        "evidence",
        "simulation"
      ],
      "additionalProperties": false
    },
    "target_input": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 6,
          "minItems": 1
        }
      },
      "required": [
        "operation_id",
        "task_id",
        "version",
        "features"
      ],
      "additionalProperties": false
    },
    "target_result": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "target_pose"
        },
        "resource": {
          "allOf": [
            {
              "$ref": "common.schema.json#/definitions/resource"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "target_pose"
                }
              }
            }
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "resource",
        "features",
        "limitations",
        "simulation"
      ],
      "additionalProperties": false
    },
    "compare_input": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "other_task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "other_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "task_id",
        "version",
        "other_task_id",
        "other_version"
      ],
      "additionalProperties": false
    },
    "compare_result": {
      "type": "object",
      "properties": {
        "comparable": {
          "type": "boolean"
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/metric"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "comparable",
        "differences",
        "changes",
        "simulation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "comparable": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "changes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "x-tools": [
    {
      "name": "create_video_analysis",
      "method": "analysis.create",
      "input": "task:create_input",
      "output": "task:summary",
      "side_effect": true,
      "purposes": [
        "analysis"
      ]
    },
    {
      "name": "get_analysis_status",
      "method": "analysis.status",
      "input": "task:lookup",
      "output": "task:summary",
