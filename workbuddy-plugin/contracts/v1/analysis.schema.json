{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tennis.local/contracts/v1/analysis.schema.json",
  "title": "Tennis analysis v1",
  "definitions": {
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "video_frame",
            "video_clip",
            "trajectory",
            "user_statement",
            "quality_frame"
          ]
        },
        "asset_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "subject_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "original_start_s": {
          "type": "number",
          "minimum": 0
        },
        "original_end_s": {
          "type": "number",
          "minimum": 0
        },
        "visible_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "body",
              "feet",
              "ball",
              "racket"
            ]
          },
          "maxItems": 200
        },
        "resource": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "common.schema.json#/definitions/resource"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "evidence_frame",
                        "evidence_clip",
                        "trajectory"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "asset_id",
        "subject_id",
        "original_start_s",
        "original_end_s",
        "visible_objects",
        "resource",
        "simulation"
      ],
      "additionalProperties": false
    },
    "stroke": {
      "type": "object",
      "properties": {
        "event_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "forehand",
            "single_backhand",
            "double_backhand",
            "serve",
            "forehand_volley",
            "backhand_volley",
            "footwork",
            "unable"
          ]
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "confidence": {
          "$ref": "common.schema.json#/definitions/confidence"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        }
      },
      "required": [
        "event_id",
        "kind",
        "start_s",
        "end_s",
        "phases",
        "confidence",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "strokes_result": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/stroke"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "events",
        "simulation"
      ],
      "additionalProperties": false
    },
    "timing_event": {
      "type": "object",
      "properties": {
        "event_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "preparation",
            "first_step",
            "main_movement",
            "moving_backswing",
            "bounce_candidate",
            "adjustment",
            "support",
            "racket_drop",
            "leg_drive_rotation",
            "forward_swing",
            "recovery"
          ]
        },
        "original_s": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "value_state": {
          "$ref": "common.schema.json#/definitions/state_of_value"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "body",
              "feet",
              "ball",
              "racket"
            ]
          },
          "maxItems": 200
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        }
      },
      "required": [
        "event_id",
        "kind",
        "original_s",
        "value_state",
        "requires",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "timing_result": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/timing_event"
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "events",
        "limitations",
        "simulation"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "metric_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "value": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "value_state": {
          "$ref": "common.schema.json#/definitions/state_of_value"
        },
        "unit": {
          "type": "string",
          "enum": [
            "relative",
            "normalized",
            "ratio",
            "event_order"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        }
      },
      "required": [
        "metric_id",
        "definition",
        "value",
        "value_state",
        "unit",
        "reference",
        "evidence_ids",
        "limitations"
      ],
      "additionalProperties": false
    },
    "metrics_result": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/metric"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "metrics",
        "simulation"
      ],
      "additionalProperties": false
    },
    "render_input": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/id"
          },
          "maxItems": 200,
          "minItems": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "frame",
            "trajectory",
            "slow_motion"
          ]
        }
      },
      "required": [
        "operation_id",
        "task_id",
        "version",
        "evidence_ids",
        "mode"
      ],
      "additionalProperties": false
    },
    "render_result": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/definitions/resource"
          },
          "maxItems": 200
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/evidence"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "resources",
        "evidence",
        "simulation"
      ],
      "additionalProperties": false
    },
    "target_input": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 6,
          "minItems": 1
        }
      },
      "required": [
        "operation_id",
        "task_id",
        "version",
        "features"
      ],
      "additionalProperties": false
    },
    "target_result": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "target_pose"
        },
        "resource": {
          "allOf": [
            {
              "$ref": "common.schema.json#/definitions/resource"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "target_pose"
                }
              }
            }
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "resource",
        "features",
        "limitations",
        "simulation"
      ],
      "additionalProperties": false
    },
    "compare_input": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "other_task_id": {
          "$ref": "common.schema.json#/definitions/id"
        },
        "other_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "task_id",
        "version",
        "other_task_id",
        "other_version"
      ],
      "additionalProperties": false
    },
    "compare_result": {
      "type": "object",
      "properties": {
        "comparable": {
          "type": "boolean"
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 200
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "analysis.schema.json#/definitions/metric"
          },
          "maxItems": 200
        },
        "simulation": {
          "type": "boolean"
        }
      },
      "required": [
        "comparable",
        "differences",
        "changes",
        "simulation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "comparable": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "changes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "x-tools": [
    {
      "name": "create_video_analysis",
      "method": "analysis.create",
      "input": "task:create_input",
      "output": "task:summary",
      "side_effect": true,
      "purposes": [
        "analysis"
      ]
    },
    {
      "name": "get_analysis_status",
      "method": "analysis.status",
      "input": "task:lookup",
      "output": "task:summary",
      "side_effect": false,
      "purposes": []
    },
    {
      "name": "cancel_analysis",
      "method": "analysis.cancel",
      "input": "task:cancel_input",
      "output": "task:summary",
      "side_effect": true,
      "purposes": []
    },
    {
      "name": "get_quality_report",
      "method": "analysis.quality",
      "input": "task:lookup",
      "output": "media:quality",
      "side_effect": false,
      "purposes": []
    },
    {
      "name": "get_stroke_events",
      "method": "analysis.strokes",
      "input": "task:lookup",
      "output": "strokes_result",
      "side_effect": false,
      "purposes": []
    },
    {
      "name": "get_groundstroke_timing",
      "method": "analysis.timing",
      "input": "task:lookup",
      "output": "timing_result",
      "side_effect": false,
      "purposes": []
    },
    {
      "name": "get_motion_metrics",
      "method": "analysis.metrics",
      "input": "task:lookup",
      "output": "metrics_result",
      "side_effect": false,
      "purposes": []
    },
    {
      "name": "render_evidence_overlay",
      "method": "evidence.render",
      "input": "render_input",
      "output": "render_result",
      "side_effect": true,
      "purposes": [
        "analysis"
      ]
    },
    {
      "name": "generate_target_pose",
      "method": "target.generate",
      "input": "target_input",
      "output": "target_result",
      "side_effect": true,
      "purposes": [
        "analysis"
      ]
    },
    {
      "name": "compare_sessions",
      "method": "sessions.compare",
      "input": "compare_input",
      "output": "compare_result",
      "side_effect": false,
      "purposes": [
        "retest"
      ]
    }
  ]
}
